# ==========================================
# VERCEL FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# The URL of your deployed Render backend API
# Example: https://amilla-backend.onrender.com
VITE_API_URL=http://localhost:8080

# ==========================================
# RENDER BACKEND ENVIRONMENT VARIABLES
# ==========================================
# Supabase PostgreSQL Database Connection URL
# Example: jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/amilla

# Supabase Database User
SPRING_DATASOURCE_USERNAME=postgres

# Supabase Database Password
SPRING_DATASOURCE_PASSWORD=your_supabase_password

# A long random string for signing JWT tokens (at least 32 characters)
AMILLA_JWT_SECRET=your_super_secret_jwt_key_that_is_long_enough_for_hs256

# JWT Expiration in milliseconds (7 days = 604800000)
AMILLA_JWT_EXPIRATION_MS=604800000

# Football Data API Token (from https://www.football-data.org/)
FOOTBALL_DATA_API_TOKEN=your_football_data_api_token

# The group code users need to register
REGISTRATION_GROUP_CODE=MUNDIAL2026
